# ---- Backend environment TEMPLATE (copy to backend/.env for local runs) ----
# COMMITTED file: keep it free of real secrets — placeholders only. Your real
# values go in backend/.env, which is git-ignored and auto-loaded by spring-dotenv
# when you run `mvn spring-boot:run` from the backend/ folder.

# ---- Server ----
SERVER_PORT=8080

# ---- Database ----
# Local MySQL example (change the password). For a hosted DB (e.g. Railway) paste
# its JDBC URL + credentials into backend/.env instead.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campusconnect?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=tharun1437
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect

# ---- Seed demo data on first empty-DB startup ----
SEED_ENABLED=true

# ---- JWT (generate with: openssl rand -base64 48) ----
JWT_SECRET=change_me_generate_a_64_byte_secret_with_openssl_rand_base64_48

# ---- Web / CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173

# ---- Mail (optional; Brevo host is smtp-relay.brevo.com, NOT ssmtp-relay) ----
MAIL_ENABLED=false
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@campusconnect.local

# ---- Payments (mock | razorpay). Set razorpay + keys in backend/.env for REAL pay. ----
PAYMENT_PROVIDER=razorpay
PAYMENT_CURRENCY=INR
# Test-mode keys look like rzp_test_*. The secret is server-side only — never commit it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ---- WhatsApp (log | twilio). ACCOUNT_SID must start with "AC"; FROM is a
#      whatsapp: number like whatsapp:+14155238886, not the "join ..." phrase. ----
WHATSAPP_PROVIDER=log
WHATSAPP_DEFAULT_COUNTRY_CODE=91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_BASE_URL=https://api.twilio.com

# ---- AI (interface-only until a key is supplied) ----
AI_ENABLED=false
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
